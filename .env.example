# Keep the server-side credentials private. Do not add NEXT_PUBLIC_ to them.
SPM_SUPABASE_URL=https://your-project-ref.supabase.co
SPM_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# These two are safe for browser use, but must belong to the same project above.
NEXT_PUBLIC_SPM_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SPM_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Set a unique secret before inviting teachers.
TEACHER_INVITE_CODE=replace-with-a-strong-invite-code
